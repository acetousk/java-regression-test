+                var input = value == null ? '' : String(value), at = 0, out = '';
+                for (var i = 0; i < parts.length; i++) {
+                    var part = parts[i];
+                    if (part.literal != null) { out += part.literal; continue; }
+                    if (at >= input.length) {
+                        out += pad.length === 1 ? pad : (pad.charAt(at) || ' ');
+                        at++;
+                        continue;
