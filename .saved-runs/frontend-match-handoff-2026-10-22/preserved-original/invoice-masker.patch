+        (function (mask, placeholder) {
+            if (mask == null || mask === '') return null;
+            var parts = [], text = String(mask);
+            for (var i = 0; i < text.length; i++) {
+                var ch = text.charAt(i);
+                if (ch === "'") {
+                    if (++i < text.length) parts.push({literal: text.charAt(i)});
+                } else if ('#ULA?*H'.indexOf(ch) >= 0) parts.push({kind: ch});
+                else parts.push({literal: ch});
+            }
+            var pad = placeholder == null ? '' : String(placeholder);
