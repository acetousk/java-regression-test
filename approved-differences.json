    {"theme": "DEFAULT_QUASAR", "sequence": 1, "java": ["STRT_STYLESHEET", null], "rust": ["STRT_STYLESHEET", "/libs/fontawesome/css/font-awesome.min.css"]},
    {"theme": "DEFAULT_QUASAR", "sequence": 2, "java": ["STRT_STYLESHEET", "/libs/font-awesome/css/font-awesome.min.css"], "rust": null},
    {"theme": "DEFAULT_QUASAR", "sequence": 3, "java": ["STRT_STYLESHEET", "https://fonts.googleapis.com/css?family=Roboto:100,300,400,500,700,900|Material+Icons"], "rust": ["STRT_STYLESHEET", "/libs/material-icons/material-icons.css"]},
    {"theme": "DEFAULT_QUASAR", "sequence": 4, "java": ["STRT_STYLESHEET", "/libs/quasar/quasar.min.css"], "rust": ["STRT_STYLESHEET", "/libs/quasar/quasar.prod.css"]}
