{
  "transaction_exemptions": [
    {"engine": "rust", "when": {"approved_difference": "seed_statistics"}},
    {"engine": "rust", "when": {"approved_difference": "rust_only_statistics"}},
    {"engine": "rust", "when": {"all": [
      {"path": "kind", "in": ["insert", "update", "delete", "truncate"]},
      {"path": "table", "in": {"ref": "rust_only_tables"}}
    ]}},
    {"engine": "rust", "when": {"all": [
      {"path": "kind", "equals": "insert"},
      {"keyed_rows": {"ref": "rust_seed_additions"}}
    ]}},
    {"engine": "rust", "when": {"all": [
      {"path": "kind", "equals": "schema"},
      {"path": "table_only", "equals": true},
      {"path": "tag", "in": ["CREATE TABLE", "CREATE INDEX"]},
      {"path": "tables", "all_in": {"ref": "rust_only_tables"}}
    ]}},
    {"engine": "rust", "when": {"all": [
      {"path": "kind", "equals": "schema"},
      {"path": "table_only", "equals": true},
      {"path": "tag", "equals": "DROP TABLE"},
      {"path": "tables", "empty": true}
    ]}}
  ],
  "rust_only_tables": [
    "public.auth_flow",
    "public.auth_flow_field_map",
    "public.auth_flow_role_map",
    "public.cluster_member",
    "public.cluster_message",
    "public.data_feed_pending",
    "public.http_session",
    "public.oauth_flow",
    "public.oidc_flow",
    "public.saml_flow",
    "public.user_ssh_key",
    "search.document_index",
    "search.moqui_http_log",
    "search.moqui_logs"
  ],
  "rust_only_columns": [
    {"table": "public.data_document_field", "name": "search_role", "type": "character varying(63)"},
    {"table": "public.data_document_field", "name": "search_weight", "type": "character(1)"},
    {"table": "public.system_message_remote", "name": "ssh_host_key_fingerprint", "type": "text"}
  ],
  "rust_only_ddl": [
    {"kind": "SCHEMA", "name": "search", "blocks": ["--\n-- Name: search; Type: SCHEMA; Schema: -; Owner: moqui\n--\n\nCREATE SCHEMA search;\n\n\nALTER SCHEMA search OWNER TO moqui;\n\n"]},
    {"kind": "EXTENSION", "name": "pg_trgm", "blocks": ["--\n-- Name: pg_trgm; Type: EXTENSION; Schema: -; Owner: -\n--\n\nCREATE EXTENSION IF NOT EXISTS pg_trgm WITH SCHEMA public;\n\n\n", "--\n-- Name: EXTENSION pg_trgm; Type: COMMENT; Schema: -; Owner: \n--\n\nCOMMENT ON EXTENSION pg_trgm IS 'text similarity measurement and index searching based on trigrams';\n\n\n"]}
  ],
  "template_differences": [
    {"table": "public.localized_message", "key": {"original": "StatusFlowTransitionNotFoundTemplate", "locale": "default"}, "field": "localized", "validator": "elvis_or", "java": "Status change not allowed from ${lookedUpStatusName?:lookedUpStatusId} to ${parameterStatusName?:parameterStatusId}"},
    {"table": "public.localized_message", "key": {"original": "UomNameTemplate", "locale": "default"}, "field": "localized", "validator": "elvis_or", "java": "${description?:''} (${abbreviation?:uomId})"},
    {"table": "public.localized_message", "key": {"original": "UsernameTemplate", "locale": "default"}, "field": "localized", "validator": "elvis_or", "java": "${userFullName ?: (lastName ? (firstName ? firstName + ' ' : '') + lastName : '')} [${username?:userId?:''}]"},
    {"table": "public.notification_topic", "key": {"topic": "ServiceJobError"}, "field": "title_template", "validator": "elvis_or", "java": "Job Error ${serviceCallRun.jobName?:''} [${serviceCallRun.jobRunId?:''}] ${serviceCallRun.errors?:'N/A'}"},
    {"table": "public.notification_topic", "key": {"topic": "WebServletError"}, "field": "title_template", "validator": "elvis_or", "java": "Web Error ${errorCode?:''} (${username?:'no user'}) ${path?:''} ${message?:'N/A'}"},
    {"table": "public.notification_topic", "key": {"topic": "ServiceJobError"}, "field": "link_template", "java": "/vapps/system/ServiceJob/JobRuns/JobRunDetail?jobRunId=${serviceCallRun.jobRunId}", "rust": "/qapps/System/ServiceJob/JobRuns/JobRunDetail?jobRunId=${serviceCallRun.jobRunId}"}
  ],
