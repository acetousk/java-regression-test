  "rust_only_statistics": {
    "approved_by": "user",
    "description": "Rust reads each related row to check a foreign key before a write (Java leaves that to the database), counts Enumeration and UserGroupPermission for its load report, and tries an UPDATE before create-or-update reads the row (Java reads first). Rust counts these as artifact hits under sub types of their own (an UPDATE probe only when it matched no row; one that updates a row is a real update); these bins are listed in the report and not compared with Java.",
    "artifact_sub_types": ["fk-check", "load-report", "update-probe"]
  },
  "java_restart": {
    "approved_by": "user",
    "description": "Java restarts its factory after the empty-database load; Rust does not. The second Java factory checks DataFeeds again at start and takes a fresh ArtifactHitBin id bank.",
    "post_restart_bins": [
      {"artifact_type": "AT_ENTITY", "artifact_sub_type": "list", "artifact_name": "moqui.entity.feed.DataFeed", "hit_count": 1}
    ],
    "sequence": {"seq_name": "moqui.server.ArtifactHitBin", "java_ahead_by": 100}
  }
